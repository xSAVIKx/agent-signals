# Local working files. They hold host details and are never published.
/local/

# Editors and systems
.DS_Store
.idea/
.vscode/

# Local Claude Code settings
.claude/settings.local.json
.claude/worktrees/

# Scenario and probe output. It holds raw screens and real paths.
/out/

# The built documentation website (tools/cmd/site).
/_site/

# Python caches and the virtual environment of the Windows driver.
__pycache__/
/.venv-driver/
python/uv.lock
